% Styl notatek ze studiów. Dla wszystkich przedmiotów naraz: zmiana tutaj dotyczy każdego PDF-a.
% Silnik: LuaLaTeX (działa też z XeLaTeX / Tectonic).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{notatki}[2026/11/04 notatki ze studiów]

\RequirePackage{iftex}
\ifPDFTeX
  \RequirePackage[T1]{fontenc}
  \RequirePackage[utf8]{inputenc}
\else
  \RequirePackage{fontspec}
  % Cały tekst: JetBrains Mono (musi być zainstalowany w systemie).
  \setmainfont{JetBrains Mono}
  \setsansfont{JetBrains Mono}
  \setmonofont{JetBrains Mono}
  % Górny pasek: mniejsza, neutralna czcionka.
  \newfontfamily\czcionkapaska{Arial}
\fi
\ifPDFTeX\newcommand{\czcionkapaska}{\sffamily}\fi
\RequirePackage[polish]{babel}
\RequirePackage[a4paper,margin=2.2cm,headheight=24pt]{geometry}
\RequirePackage{amsmath,amssymb,mathtools}
\RequirePackage{graphicx,xcolor,booktabs,fancyhdr,float}
\RequirePackage[most]{tcolorbox}
\RequirePackage[hidelinks,bookmarksnumbered]{hyperref}

% ── Kolory ───────────────────────────────────────────────────────────────────
\definecolor{akcent}{HTML}{C98A00}
\definecolor{tusz}{HTML}{2B2B2B}
\definecolor{niebieski}{HTML}{3B6FB6}
\definecolor{zielony}{HTML}{3F8F5B}
\definecolor{pomarancz}{HTML}{D9822B}
\definecolor{czerwien}{HTML}{C0453A}
\definecolor{fiolet}{HTML}{7A55B3}

% ── Układ ────────────────────────────────────────────────────────────────────
\setlength{\parindent}{0pt}
\setlength{\parskip}{6pt}
% Tylko pakiety, które ma też BasicTeX (bez enumitem / titlesec).
\def\@listi{\leftmargin\leftmargini \topsep 4\p@ \parsep 0\p@ \itemsep 2\p@}
\let\@listI\@listi
\def\@listii{\leftmargin\leftmarginii \labelwidth\leftmarginii \advance\labelwidth-\labelsep \topsep 2\p@ \parsep 0\p@ \itemsep 2\p@}
\setcounter{tocdepth}{2}
\setcounter{secnumdepth}{3}

\renewcommand{\section}{\@startsection{section}{1}{\z@}{-3.2ex plus -1ex minus -.2ex}{1.4ex plus .2ex}{\normalfont\Large\bfseries\color{akcent}}}
\renewcommand{\subsection}{\@startsection{subsection}{2}{\z@}{-2.6ex plus -1ex minus -.2ex}{1ex plus .2ex}{\normalfont\large\bfseries\color{tusz}}}
\renewcommand{\subsubsection}{\@startsection{subsubsection}{3}{\z@}{-2.2ex plus -1ex minus -.2ex}{0.8ex plus .2ex}{\normalfont\normalsize\bfseries\color{niebieski}}}

% Nazwa przedmiotu = nazwa folderu (appka ustawia ją przed wczytaniem stylu); \przedmiot{…} ją zmienia.
\providecommand{\przedmiotduze}{}
\providecommand{\przedmiotmale}{}
\gdef\@autorn{}
\newcommand{\przedmiot}[1]{\gdef\przedmiotmale{#1}\gdef\przedmiotduze{\MakeUppercase{#1}}}
\newcommand{\autor}[1]{\gdef\@autorn{#1}}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{akcent}\leaders\hrule height \headrulewidth\hfill}}
% Pasek: lewy napis notatki (domyślnie nazwa przedmiotu) | data notatki. \notatka wstawia znaczniki;
% \LastMark daje ostatni na stronie (z dwiema notatkami: tej, która zaczyna się później), a bez
% znacznika — poprzedni. Starsze jądra LaTeX-a (np. wbudowany Tectonic) nie mają nowych znaczników:
% wtedy pasek bez daty, a po lewej zawsze przedmiot.
\ifdefined\NewMarkClass
  \NewMarkClass{notatka}
  \NewMarkClass{lewy}
  \AtBeginDocument{\InsertMark{lewy}{\przedmiotmale}}
  \newcommand{\@lewynapis}{\LastMark{lewy}}
\else
  \newcommand{\InsertMark}[2]{}
  \newcommand{\LastMark}[1]{}
  \newcommand{\@lewynapis}{\przedmiotmale}
\fi
\fancyhead[L]{\czcionkapaska\footnotesize\color{gray}\@lewynapis}
\fancyhead[R]{\czcionkapaska\footnotesize\color{gray}\LastMark{notatka}}
\fancyfoot[C]{\small\thepage}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\small\thepage}\renewcommand{\headrulewidth}{0pt}}

% Strona tytułowa + spis treści. Pomijana w PDF-ie pojedynczej notatki.
\newcommand{\okladka}{%
  \begingroup\centering
  {\fontspec{Arial Black}\Huge\color{akcent}\przedmiotduze\par}\vspace{4pt}
  {\large\@autorn\par}\vspace{0.6em}
  {\color{akcent}\rule{\linewidth}{0.8pt}}\par
  \endgroup
  \tableofcontents
  \clearpage}

% Data: RRRR-MM-DD (lub DD.MM.RRRR) → „4 listopada 2026”.
\newcommand{\@miesiac}[1]{\ifcase\numexpr#1\relax\or stycznia\or lutego\or marca\or kwietnia\or maja\or czerwca\or lipca\or sierpnia\or września\or października\or listopada\or grudnia\fi}
\def\@dataiso#1-#2-#3\@nil{\xdef\@dataformat{\the\numexpr#3\relax\space\@miesiac{#2}\space\the\numexpr#1\relax}}
\def\@datadmr#1.#2.#3\@nil{\xdef\@dataformat{\the\numexpr#1\relax\space\@miesiac{#2}\space\the\numexpr#3\relax}}
\newcommand{\@ustawdate}[1]{%
  \in@{-}{#1}\ifin@\@dataiso#1\@nil\else
  \in@{.}{#1}\ifin@\@datadmr#1\@nil\else\gdef\@dataformat{#1}\fi\fi}

% Jedna notatka = jedna sekcja. \notatka[data][lewy napis]{Tytuł}; data trafia do paska u góry
% strony z prawej, lewy napis z lewej (pusty = nazwa przedmiotu). Data pod tytułem tylko w PDF-ie
% całego przedmiotu: w pojedynczej notatce appka definiuje \notatkasolo.
% \bezspisu przed \notatka = ta notatka bez spisu podrozdziałów (działa tylko na najbliższą \notatka).
\newif\if@bezspisu
\newcommand{\bezspisu}{\global\@bezspisutrue}
\NewDocumentCommand{\notatka}{O{} O{} m}{%
  \section{#3}%
  \if\relax\detokenize{#2}\relax
    \InsertMark{lewy}{\przedmiotmale}%
  \else
    \InsertMark{lewy}{#2}%
  \fi
  \if\relax\detokenize{#1}\relax
    \InsertMark{notatka}{}%
  \else
    \@ustawdate{#1}%
    \InsertMark{notatka}{\@dataformat}%
    \ifdefined\notatkasolo\else{\small\color{gray}\@dataformat\par}\fi
  \fi
  \ifdefined\notatkasolo\@spisnotatki\fi
  \global\@bezspisufalse}

% Spis podrozdziałów pod tytułem — tylko w PDF-ie pojedynczej notatki (jedna sekcja, więc cały spis
% treści to jej podrozdziały). Liczba wpisów z poprzedniego przebiegu (.aux): bez podrozdziałów nie
% ma ramki. Wpisy klikalne (hyperref).
\gdef\@ilewpisow{0}
\newcounter{@wpisyspisu}
\AtEndDocument{\immediate\write\@auxout{\gdef\string\@ilewpisow{\the\value{@wpisyspisu}}}}
\def\@wpisspisu#1#2#3#4{% #1 wcięcie, #2 szerokość numeru, #3 tekst z \numberline, #4 strona
  \par\noindent\hspace*{#1}%
  {\def\numberline##1{\hbox to #2{\color{akcent}\bfseries##1\hfil}}#3}%
  \nobreak\leaders\hbox{$\m@th\mkern4mu\cdot\mkern4mu$}\hfill\nobreak
  \hbox to 1.8em{\hss\color{gray}#4}\par}
\newcommand{\@spisnotatki}{%
  \ifnum\if@bezspisu\z@\else\@ilewpisow\fi>\z@
    \begin{tcolorbox}[kolorboks=akcent, title={W tej notatce}, top=7pt, after skip=14pt]
      \small\setlength{\parskip}{3pt}%
      \def\l@section##1##2{}%
      \def\l@subsection##1##2{\@wpisspisu{0pt}{2.6em}{##1}{##2}}%
      \def\l@subsubsection##1##2{{\footnotesize\color{tusz!75}\@wpisspisu{1.6em}{3.6em}{##1}{##2}}}%
      \@starttoc{toc}%
    \end{tcolorbox}%
  \else
    % Spis i tak otwarty, żeby .toc powstał już w tym przebiegu.
    \setbox\z@\vbox{\@starttoc{toc}}%
  \fi}
\let\@notatki@sub\subsection
\let\@notatki@subsub\subsubsection
\renewcommand{\subsection}{\stepcounter{@wpisyspisu}\@notatki@sub}
\renewcommand{\subsubsection}{\stepcounter{@wpisyspisu}\@notatki@subsub}

% ── Boksy ────────────────────────────────────────────────────────────────────
% Tło boksu: 22% koloru. Przy tak mocnym tle boks jest widoczny w podglądzie „Papier nocny”
% (pdf.js zamienia PDF na 6 poziomów szarości wg jasności; słabsze tło, ok. 6%, zlewa się wtedy ze stroną).
\newcommand{\tlopudelka}{22}
\tcbset{
  notatkibox/.style={
    enhanced, breakable, boxrule=0pt, arc=2pt,
    left=8pt, right=8pt, top=5pt, bottom=5pt, before skip=8pt, after skip=8pt,
    fonttitle=\bfseries\small,
    attach boxed title to top left={yshift=-2mm},
    boxed title style={empty,left=0pt,top=0pt,bottom=0pt},
  },
  kolorboks/.style={
    notatkibox, colback={#1!\tlopudelka}, colframe=#1,
    borderline west={2.5pt}{0pt}{#1}, coltitle=#1!80!black,
  },
}

% \begin{fakty}[Tytuł] — ciekawostki, kontekst, liczby.
\newtcolorbox{fakty}[1][Fakty]{kolorboks=niebieski, title={#1}}
\newtcolorbox{uwaga}[1][Uwaga]{kolorboks=pomarancz, title={#1}}
\newtcolorbox{wazne}[1][Ważne]{kolorboks=czerwien, title={#1}}
\newtcolorbox{pulapka}[1][Pułapka]{kolorboks=czerwien, title={#1}}
\newtcolorbox{podsumowanie}[1][Podsumowanie]{kolorboks=zielony, title={#1}}

% Definicje i twierdzenia: wspólna numeracja w obrębie sekcji. \begin{definicja}[Nazwa]
\newtcolorbox[auto counter,number within=section]{definicja}[1][]{%
  kolorboks=fiolet, title={Definicja~\thetcbcounter\ifstrempty{#1}{}{: #1}}}
\newtcolorbox[use counter from=definicja]{twierdzenie}[1][]{%
  kolorboks=fiolet, title={Twierdzenie~\thetcbcounter\ifstrempty{#1}{}{: #1}}}

% ── Drobiazgi ────────────────────────────────────────────────────────────────
\newcommand{\pojecie}[1]{\textbf{\color{akcent}#1}}
\providecommand{\degree}{^{\circ}}
